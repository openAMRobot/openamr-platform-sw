    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.35 0 0.20" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <!-- Optical frame: ROS convention (Z forward, X right, Y down) -->
  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
  </joint>

  <!-- ── OpenAMRobot 2.0 sensor frames (Alex decision 2026-10-12) ────── -->

  <!-- Base camera, Orbbec Gemini 336L. Tilt is a configuration ID:
       base_tilt:=bt05 / bt10 / bt15 -> pitch -0.0873 / -0.1745 / -0.2618 rad
       (5 / 10 / 15 deg up), default bt10 (Alex decision 2026-10-12).
       An unknown base_tilt value fails the xacro expansion. -->
  <xacro:arg name="base_tilt" default="bt10"/>
  <!-- Legacy Gate A IMX708 simulation sensor selection; camera frames remain
       available for existing docking and perception consumers. -->
  <xacro:arg name="legacy_camera" default="false"/>
  <xacro:property name="base_camera_pitch"
    value="${dict(bt05=-0.0873, bt10=-0.1745, bt15=-0.2618)['$(arg base_tilt)']}"/>

  <link name="base_camera_link"/>
  <!-- xyz (0.376, 0, 0.0445) (Alex decision 2026-10-12, STEP MMP.00.00.00.000) -->
  <joint name="base_camera_joint" type="fixed">
    <origin xyz="0.376 0 0.0445" rpy="0 ${base_camera_pitch} 0"/>
    <parent link="base_link"/>
    <child link="base_camera_link"/>
  </joint>

  <!-- Optical frames: ROS optical convention, z forward, x right, y down
       (Alex decision 2026-10-12) -->
  <link name="base_camera_color_optical_frame"/>
  <joint name="base_camera_color_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    <parent link="base_camera_link"/>
    <child link="base_camera_color_optical_frame"/>
  </joint>

  <link name="base_camera_depth_optical_frame"/>
  <joint name="base_camera_depth_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    <parent link="base_camera_link"/>
    <child link="base_camera_depth_optical_frame"/>
  </joint>

  <!-- IMU, ICM-42688-P: xyz (0.195, 0, -0.044), rpy 0 (Alex decision 2026-10-12,
       STEP MMP.00.00.00.000). base plate top; board stack height added from the
       mount drawing. -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <origin xyz="0.195 0 -0.044" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <!-- Near-field sensors at the panel hole centres, fixed to base_link
       (Alex decision 2026-10-12, STEP MMP.00.00.00.000). -->
  <xacro:macro name="near_field_frame" params="name x y z pitch:=0 yaw:=0">
    <link name="${name}"/>
    <joint name="${name}_joint" type="fixed">
      <origin xyz="${x} ${y} ${z}" rpy="0 ${pitch} ${yaw}"/>
      <parent link="base_link"/>
      <child link="${name}"/>
    </joint>
  </xacro:macro>

  <!-- Ultrasonic, MB7060 (Alex decision 2026-10-12, STEP MMP.00.00.00.000) -->
  <xacro:near_field_frame name="us_front_left" x="0.390" y="0.130" z="-0.0066"/>
  <xacro:near_field_frame name="us_front_right" x="0.390" y="-0.130" z="-0.0066"/>
  <xacro:near_field_frame name="us_rear_left" x="-0.390" y="0.130" z="-0.0066" yaw="${pi}"/>
  <xacro:near_field_frame name="us_rear_right" x="-0.390" y="-0.130" z="-0.0066" yaw="${pi}"/>

  <!-- ToF, TF-Luna (Alex decision 2026-10-12, STEP MMP.00.00.00.000).
       20 degree down screening value until the bench test. -->
  <xacro:near_field_frame name="tof_front" x="0.390" y="0" z="-0.0066" pitch="0.3491"/>
  <!-- 20 degree down screening value until the bench test. -->
  <xacro:near_field_frame name="tof_rear" x="-0.390" y="0" z="-0.0066" pitch="0.3491" yaw="${pi}"/>

  <xacro:include filename="gazebo_control.xacro" />


</robot>
