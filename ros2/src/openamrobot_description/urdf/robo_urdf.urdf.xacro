         at x 0.321; lidar_link is kept at 0.330 until that is decided. -->
    <origin
      xyz="0.330 0 0.124"
      rpy="0 0 ${pi}" />
    <parent
      link="base_link" />
    <child
      link="lidar_link" />
    <axis
      xyz="0 0 0" />
  </joint>

  <!-- Camera link — mounted at front of robot, facing forward.
       legacy IMX708, Gate A. Kept unchanged with its consumers (Alex decision
       2026-10-12); the 2.0 base camera is base_camera_link below. -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.08 0.04"/>
      </geometry>
      <material name="camera_black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.08 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.35 0 0.20" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <!-- Optical frame: ROS convention (Z forward, X right, Y down) -->
  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
  </joint>

  <xacro:arg name="legacy_camera" default="true"/>

  <!-- OpenAMRobot 2.0 sensor frames: Gemini 336L, IMU, TF-Luna, MB7060 (#49) -->
  <xacro:include filename="sensors.xacro" />

  <xacro:include filename="gazebo_control.xacro" />


</robot>
