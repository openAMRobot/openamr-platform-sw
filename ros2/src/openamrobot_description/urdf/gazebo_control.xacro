<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ── Contact friction ───────────────────────────────────────────────────
       The URDF to SDF conversion drops a raw <surface> written under <gazebo reference>
       (gz sdf -p warns "surface, child of link, not defined in SDF" and copies it to the
       link, where physics ignores it). Before this change every wheel contact therefore ran
       at the default mu 1, and the four caster spheres, lumped into base_footprint by their
       fixed joints, dragged at mu 1. <mu1>, <mu2> and <fdir1> are the tags the conversion
       applies to every collision of the link, lumped ones included.
       The values are the ones this file already carried: no new number.
       The contact-stiffness values (kp, kd, min_depth, max_vel) of the old blocks were
       dropped the same way and are not applied here; applying them is a separate decision.
       slip1/slip2 0.001 of the drive wheels have no URDF tag and are not applied either.
       Simulation estimates, not measured tyre or castor materials.
       Test: test/test_gazebo_friction.py -->
  <xacro:macro name="drive_wheel_friction">
    <mu1>1.5</mu1>
    <mu2>0.5</mu2>
    <fdir1>1 0 0</fdir1>
  </xacro:macro>
  <!-- Frictionless support/slider approximation. The caster joints are fixed, so the
       spheres cannot roll; mu 0 lets them slide under the base instead of dragging it.
       Caster rolling and contact dynamics are not modelled and not verified. -->
  <xacro:macro name="caster_friction">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </xacro:macro>

  <!-- ── World-level plugins (no reference attribute) ─────────────── -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <!-- wheel separation: track 0.400 m is a placeholder from the 2023 STEP and the general arrangement; decisions.yaml DRIVE-TRACK is open and the 2.0 wheel assembly will change it; Gate A unit measured 0.46 m (2026-06-19).
           Was 0.4075, superseded by Alex decision 2026-10-12 -->
      <wheel_separation>0.400</wheel_separation>
      <!-- wheel radius 0.100 (Alex decision 2026-10-12, STEP MMP.00.00.00.000);
           was 0.11, superseded by Alex decision 2026-10-12 -->
      <wheel_radius>0.100</wheel_radius>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <min_linear_acceleration>-0.5</min_linear_acceleration>
      <max_angular_acceleration>1.0</max_angular_acceleration>
      <min_angular_acceleration>-1.0</min_angular_acceleration>
      <max_linear_velocity>1.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
      <topic>/cmd_vel</topic>
      <frame_id>odom</frame_id>
      <!-- odom child is the URDF root base_footprint (REP 105, Alex decision
           2026-10-12), so base_link keeps a single parent; was base_link,
           superseded by Alex decision 2026-10-12 -->
      <child_frame_id>base_footprint</child_frame_id>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ── Link-level: base_link ─────────────────────────────────────── -->
  <gazebo reference="base_link">
    <material>Gazebo/White</material>
    <gravity>true</gravity>
    <surface>
      <friction>
        <ode>
          <mu>0.2</mu>
          <mu2>0.2</mu2>
        </ode>
      </friction>
      <contact>
        <ode>
          <kp>1e6</kp>
          <kd>100</kd>
        </ode>
      </contact>
    </surface>
  </gazebo>

  <!-- ── Link-level: left_wheel_link ────────────────────────────────────── -->
  <gazebo reference="left_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <xacro:drive_wheel_friction/>
  </gazebo>

  <!-- ── Link-level: right_wheel_link ───────────────────────────────────── -->
  <gazebo reference="right_wheel_link">
    <material>Gazebo/DarkGrey</material>
    <xacro:drive_wheel_friction/>
  </gazebo>

  <!-- ── Link-level: caster wheels ───────────────────────────────────── -->
  <!-- We apply low friction to caster wheels to prevent them from catching and dragging in Gazebo -->
  <xacro:macro name="caster_gazebo" params="prefix">
    <gazebo reference="${prefix}_caster_link">
      <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/DarkGrey</material>
      <xacro:caster_friction/>
    </gazebo>
  </xacro:macro>

  <xacro:caster_gazebo prefix="fl" />
  <xacro:caster_gazebo prefix="fr" />
  <xacro:caster_gazebo prefix="bl" />
  <xacro:caster_gazebo prefix="br" />

  <!-- ── Link-level: camera_link — forward-facing RGB camera ──────── -->
  <!-- Legacy Gate A IMX708, not 2.0 hardware and not in config/sensor_profiles.yaml
       (RG-SEN-036). Kept: the AprilTag docking pipeline reads /rgb_image and
       camera_optical_frame; removing it is a contract change (#156, #53, #105). -->
  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
    <sensor name="camera_sensor" type="camera">
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
      <topic>/rgb_image</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <update_rate>12</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>15.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- ── Link-level: base_camera_link — Orbbec Gemini 336L RGB-D (#156, RG-SEN-007) ── -->
  <!-- From config/sensor_profiles.yaml base_camera_link.depth: 90 deg horizontal field of
       view, 1280 x 800, 30 Hz (the maximum at that size; the robot's rate is set in the driver
       launch), depth clip 0.17 to 20 m. One rgbd_camera has one field of view, so the colour
       channel (94 x 68 deg, up to 60 Hz) is not modelled separately; Gazebo derives the vertical
       field of view from the aspect, 64.0 deg against 65 in the profile. image_noise_stddev is
       null: no noise block. Gazebo topic /base_camera/rgbd (Gazebo appends /image,
       /depth_image, /points, /camera_info) and sensor name as in #53; Proposed, not bridged to
       ROS: the ROS topics are a contract change (#53, #41). The legacy /rgb_image sensor
       above stays: docking reads it. -->
  <xacro:property name="gemini_depth" value="${sensor_profiles['base_camera_link']['channels']['depth']}"/>
  <xacro:property name="gemini_noise_stddev"
                  value="${sensor_profiles['base_camera_link']['channels']['color']['image_noise_stddev']['value']}"/>
  <gazebo reference="base_camera_link">
    <sensor name="gemini_rgbd_sensor" type="rgbd_camera">
      <pose relative_to="base_camera_link">0 0 0 0 0 0</pose>
      <topic>/base_camera/rgbd</topic>
      <gz_frame_id>base_camera_color_optical_frame</gz_frame_id>
      <update_rate>${gemini_depth['frame_rate_max']['value']}</update_rate>
      <camera>
        <horizontal_fov>${radians(gemini_depth['fov_horizontal']['value'])}</horizontal_fov>
        <image>
          <width>${gemini_depth['width_max']['value']}</width>
          <height>${gemini_depth['height_max']['value']}</height>
          <format>R8G8B8</format>
        </image>
        <depth_camera>
          <clip>
            <near>${gemini_depth['range_min']['value']}</near>
            <far>${gemini_depth['range_max']['value']}</far>
          </clip>
        </depth_camera>
        <xacro:if value="${gemini_noise_stddev is not None}">
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>${gemini_noise_stddev}</stddev>
          </noise>
        </xacro:if>
      </camera>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- ── Link-level: imu_link — simulated IMU (from #69) ─────────────── -->
  <!-- Publishes gz topic "imu", which config/gz_bridge.yaml bridges to /imu.
       The sensor sits on imu_link with no pose offset; the frame (sensor axes,
       yaw -90 deg) is declared in sensors.xacro. The rate matches the 0.02 s
       nominal period in openamrobot_nav2 navigation_status_profile.yaml; it is not from
       config/sensor_profiles.yaml, where the output data rate the firmware sets is null
       (imu_link.gyro.odr, TODO(Evans)); reported in #156, kept until the owner decides.
       No noise model: the profile's per-sample noise (rms_noise_100hz) holds only at a
       100 Hz noise bandwidth, which the firmware filter sets and is not known, and the bias
       figures are tolerances, not standard deviations. Simulation only. -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <pose relative_to="imu_link">0 0 0 0 0 0</pose>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- The IMU system updates every imu sensor; neither walled_world.sdf nor
       a world that composes this model loads it, so the model does. -->
  <gazebo>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  </gazebo>

  <!-- ── Link-level: lidar_link — sensor ONLY here ─────────────────── -->
  <!-- RPLIDAR S3 from config/sensor_profiles.yaml (lidar_link.scan, #156): range 0.05 m to
       40 m (white target; Gazebo has no reflectivity, the 15 m black-target limit is not
       modelled), resolution 10 mm, 10 Hz, samples per turn 360 / 0.1125 deg = 3200.
       range_noise_stddev is null (the +-30 mm accuracy is a limit, not a standard deviation):
       no noise block. Was 0.40 to 10 m, 360 samples, stddev 0.001 m (no source). -->
  <xacro:property name="lidar_scan" value="${sensor_profiles['lidar_link']['channels']['scan']}"/>
  <xacro:property name="lidar_noise_stddev" value="${lidar_scan['range_noise_stddev']['value']}"/>
  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
    <sensor name="lidar_sensor" type="gpu_lidar">
      <pose relative_to="lidar_link">0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>${lidar_scan['scan_rate']['value']}</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>${int(round(360.0 / lidar_scan['angular_resolution']['value']))}</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>${lidar_scan['range_min']['value']}</min>
          <max>${lidar_scan['range_max_white']['value']}</max>
          <resolution>${lidar_scan['range_resolution']['value'] * 0.001}</resolution>
        </range>
        <xacro:if value="${lidar_noise_stddev is not None}">
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>${lidar_noise_stddev}</stddev>
          </noise>
        </xacro:if>
      </lidar>
      <visualize>false</visualize>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

</robot>
