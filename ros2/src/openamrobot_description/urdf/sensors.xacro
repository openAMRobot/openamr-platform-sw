<?xml version="1.0"?>
<!-- OpenAMRobot 2.0 base sensor frames (#49). Included by robo_urdf.urdf.xacro.
     Poses are in base_link (REP 105: drive-axle midpoint, 0.098 m above the floor),
     taken from the CAD Rev B full assembly STEP MMP.00.00.00.000 (2026-10-13,
     openamr-platform-hw). Each value, its CAD source and status are listed in
     config/sensor_frames.yaml; keep both files in step. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="sensor_black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <!-- Base camera, Orbbec Gemini 336L. Tilt is a configuration ID:
       base_tilt:=bt00 / bt05 / bt10 / bt15 -> pitch 0 / -0.0873 / -0.1745 / -0.2618 rad
       (0 / 5 / 10 / 15 deg up), default bt10 (Alex decision 2026-10-12; CAD Rev B
       camera mount MMP.01.00.00.003 is 10 deg up).
       An unknown base_tilt value fails the xacro expansion. -->
  <xacro:arg name="base_tilt" default="bt10"/>
  <xacro:property name="base_camera_pitch"
    value="${dict(bt00=0.0, bt05=-0.0873, bt10=-0.1745, bt15=-0.2618)['$(arg base_tilt)']}"/>

  <!-- Origin of the Gemini 336L model in the CAD, front glass, centre of the body.
       Body 0.029 x 0.124 x 0.029 m behind it. -->
  <link name="base_camera_link">
    <visual>
      <origin xyz="-0.0124 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.029 0.124 0.029"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>
  <!-- xyz (0.386, 0, 0.0447) on the 10 deg camera mount MMP.01.00.00.003
       (CAD Rev B, STEP MMP.00.00.00.000 v0.2);
       was (0.376, 0, 0.0445), superseded by CAD Rev B (2026-10-13) -->
  <joint name="base_camera_joint" type="fixed">
    <origin xyz="0.386 0 0.0447" rpy="0 ${base_camera_pitch} 0"/>
    <parent link="base_link"/>
    <child link="base_camera_link"/>
  </joint>

  <!-- Optical frames: ROS optical convention, z forward, x right, y down
       (Alex decision 2026-10-12) -->
  <link name="base_camera_color_optical_frame"/>
  <joint name="base_camera_color_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    <parent link="base_camera_link"/>
    <child link="base_camera_color_optical_frame"/>
  </joint>

  <link name="base_camera_depth_optical_frame"/>
  <joint name="base_camera_depth_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    <parent link="base_camera_link"/>
    <child link="base_camera_depth_optical_frame"/>
  </joint>

  <!-- IMU, ICM-42688-P: xyz (0.195, 0, -0.044), rpy 0 (Alex decision 2026-10-12,
       STEP MMP.00.00.00.000). base plate top; board stack height added from the
       mount drawing. Not in the CAD Rev B assembly; unchanged. -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <origin xyz="0.195 0 -0.044" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <!-- Near-field range sensors. The frame sits at the centre of the sensor face,
       x along the beam; positive pitch tilts the beam down. -->
  <xacro:macro name="tof_frame" params="name x y z pitch yaw:=0">
    <!-- TF-Luna body 0.014 x 0.031 x 0.021 m behind the lens face -->
    <link name="${name}">
      <visual>
        <origin xyz="-0.007 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.014 0.031 0.021"/>
        </geometry>
        <material name="sensor_black"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <origin xyz="${x} ${y} ${z}" rpy="0 ${pitch} ${yaw}"/>
      <parent link="base_link"/>
      <child link="${name}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="ultrasonic_frame" params="name x y z yaw:=0">
    <!-- MaxSonar WR housing, cylinder 0.031 m diameter, 0.0385 m long behind the face -->
    <link name="${name}">
      <visual>
        <origin xyz="-0.01925 0 0" rpy="0 ${pi/2} 0"/>
        <geometry>
          <cylinder radius="0.0155" length="0.0385"/>
        </geometry>
        <material name="sensor_black"/>
      </visual>
    </link>
    <joint name="${name}_joint" type="fixed">
      <origin xyz="${x} ${y} ${z}" rpy="0 0 ${yaw}"/>
      <parent link="base_link"/>
      <child link="${name}"/>
    </joint>
  </xacro:macro>

  <!-- ToF, TF-Luna, four corners (CAD Rev B, STEP MMP.00.00.00.000).
       Pitch 10 deg down from the 10 deg sensor face of the TF-Luna mount MMP.00.00.00.005
       (the assembly mates still show 16.23 front / 13.77 rear, not intended).
       Supersedes tof_front / tof_rear at (+-0.390, 0, -0.0066) with a 20 deg down
       screening value (Alex decision 2026-10-12). -->
  <xacro:tof_frame name="tof_front_left" x="0.3945" y="0.130" z="-0.0074" pitch="0.1745"/>
  <xacro:tof_frame name="tof_front_right" x="0.3945" y="-0.130" z="-0.0074" pitch="0.1745"/>
  <xacro:tof_frame name="tof_rear_left" x="-0.3933" y="0.130" z="-0.0074" pitch="0.1745" yaw="${pi}"/>
  <xacro:tof_frame name="tof_rear_right" x="-0.3933" y="-0.130" z="-0.0074" pitch="0.1745" yaw="${pi}"/>

  <!-- Ultrasonic, MB7060, front and rear centre (CAD Rev B, STEP MMP.00.00.00.000).
       Height from the panel hole centres. Supersedes us_front_left / us_front_right /
       us_rear_left / us_rear_right at (+-0.390, +-0.130, -0.0066)
       (Alex decision 2026-10-12). -->
  <xacro:ultrasonic_frame name="us_front" x="0.394" y="0" z="-0.0066"/>
  <xacro:ultrasonic_frame name="us_rear" x="-0.391" y="0" z="-0.0066" yaw="${pi}"/>

  <!-- ── Gazebo range sensors (simulation only) ─────────────────────────── -->
  <xacro:macro name="range_sensor_gazebo" params="name topic samples half_angle range_min range_max rate">
    <gazebo reference="${name}">
      <sensor name="${name}_sensor" type="gpu_lidar">
        <pose relative_to="${name}">0 0 0 0 0 0</pose>
        <topic>${topic}</topic>
        <gz_frame_id>${name}</gz_frame_id>
        <update_rate>${rate}</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>${samples}</samples>
              <resolution>1</resolution>
              <min_angle>${-half_angle}</min_angle>
              <max_angle>${half_angle}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${range_min}</min>
            <max>${range_max}</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
        <visualize>false</visualize>
        <always_on>true</always_on>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- TF-Luna: 2 deg field of view, 0.2 to 8 m -->
  <xacro:range_sensor_gazebo name="tof_front_left" topic="/tof/front_left"
    samples="3" half_angle="0.0175" range_min="0.20" range_max="8.0" rate="50"/>
  <xacro:range_sensor_gazebo name="tof_front_right" topic="/tof/front_right"
    samples="3" half_angle="0.0175" range_min="0.20" range_max="8.0" rate="50"/>
  <xacro:range_sensor_gazebo name="tof_rear_left" topic="/tof/rear_left"
    samples="3" half_angle="0.0175" range_min="0.20" range_max="8.0" rate="50"/>
  <xacro:range_sensor_gazebo name="tof_rear_right" topic="/tof/rear_right"
    samples="3" half_angle="0.0175" range_min="0.20" range_max="8.0" rate="50"/>

  <!-- MB7060: approximated as a narrow horizontal fan, 0.2 to 7.65 m, 10 Hz -->
  <xacro:range_sensor_gazebo name="us_front" topic="/ultrasonic/front"
    samples="9" half_angle="0.17" range_min="0.20" range_max="7.65" rate="10"/>
  <xacro:range_sensor_gazebo name="us_rear" topic="/ultrasonic/rear"
    samples="9" half_angle="0.17" range_min="0.20" range_max="7.65" rate="10"/>

</robot>
