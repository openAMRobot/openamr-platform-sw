<!--
  Platform-sw#124 D-19 (Alex's finding on #90). See navigate_to_pose.xml's own
  comment for the full reasoning - same consolidation, same two changes, for this
  navigator's tree: adopted from #92's navigate_through_poses.xml (which carries #91's
  navigate_to_pose.xml fix as an ancestor) rather than keep this file's own, simpler
  BackUp-only removal diverging from it; #91/#92 are to be closed once this lands. Plus the
  one addition this file alone needs: goal_checker_id="general_goal_checker" on FollowPath,
  required once #164 adds a second goal checker.

  This Behavior Tree replans the global path periodically at 1 Hz through an array of poses
  continuously and it also has recovery actions specific to planning / control as well as
  general system issues.

  ClearEntireCostmap -> ClearCostmapAroundRobot (bounded, reset_distance 3.0 m global / 1.5 m
  local) in all four places, with a named Wait(2.0s) immediately before each inline clear -
  same values and same naming convention (RecoveryTracker matches the bare "Wait" node name
  to count a recovery attempt; these inline waits are named so they are never mistaken for
  one) as navigate_to_pose.xml. BackUp REMOVED from the outer round-robin (D-19).
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <ControllerSelector selected_controller="{selected_controller}" default_controller="FollowPath" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
        <RateController hz="0.333">
          <RecoveryNode number_of_retries="1" name="ComputePathThroughPoses">
            <ReactiveSequence>
              <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.7"/>
              <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}"/>
            </ReactiveSequence>
            <Sequence>
              <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
              <Wait name="WaitBeforeClear-GlobalContext" wait_duration="2.0"/>
              <ClearCostmapAroundRobot name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_around_global_costmap" reset_distance="3.0"/>
            </Sequence>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}" goal_checker_id="general_goal_checker"/>
          <Sequence>
            <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
            <Wait name="WaitBeforeClear-LocalContext" wait_duration="2.0"/>
            <ClearCostmapAroundRobot name="ClearLocalCostmap-Context" service_name="local_costmap/clear_around_local_costmap" reset_distance="1.5"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <Sequence>
        <Fallback>
          <WouldAControllerRecoveryHelp error_code="{follow_path_error_code}"/>
          <WouldAPlannerRecoveryHelp error_code="{compute_path_error_code}"/>
        </Fallback>
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <RoundRobin name="RecoveryActions">
            <Sequence name="ClearingActions">
              <ClearCostmapAroundRobot name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_around_local_costmap" reset_distance="1.5"/>
              <ClearCostmapAroundRobot name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_around_global_costmap" reset_distance="3.0"/>
            </Sequence>
            <Spin spin_dist="1.57" error_code_id="{spin_error_code}"/>
            <Wait wait_duration="5.0"/>
          </RoundRobin>
        </ReactiveFallback>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
