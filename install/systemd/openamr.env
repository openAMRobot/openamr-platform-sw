# /etc/openamr/openamr.env, read by the openamr-*.service units (EnvironmentFile).
# Plain KEY=VALUE lines only. No export, no shell expansion.

# --- ROS 2 graph ---------------------------------------------------------------------
# Same on every robot host and on the operator laptop, never changed at run time.
# TODO(Karthikeyan): confirm the production domain. 0 is what the existing docs use.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# The tablet never joins DDS over Wi-Fi; it talks to rosbridge only (see install/jetson/README.md).
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
CYCLONEDDS_URI=file:///etc/openamr/cyclonedds.xml

# --- ROS installation ----------------------------------------------------------------
ROS_DISTRO=jazzy
# Workspace overlay with the openamrobot_* packages (colcon install space).
OPENAMR_WS=/opt/openamr/ros2/install

# --- Base controller link --------------------------------------------------------------
# First bench uses serial or USB CDC, not micro-ROS over Ethernet (open hard-fault report).
# Release 001 rig: /dev/openamr/teensy at 115200. For the NUCLEO-H723ZG the device and baud
# rate come from the firmware; TODO(Evans) until PR #22 has a micro-ROS application.
OPENAMR_AGENT_DEVICE=/dev/openamr/teensy
OPENAMR_AGENT_BAUD=115200

# --- Bring-up profile ------------------------------------------------------------------
# Launch arguments for openamrobot_bringup. Read by openamr-bringup-run.sh, split on spaces.
# The H-day legacy profile is the default shipped here. There is no default map: the launch
# refuses to start without one, so set OPENAMR_MAP before enabling the unit.
OPENAMR_BRINGUP_LAUNCH=hday_legacy.launch.py
OPENAMR_MAP=
OPENAMR_BRINGUP_EXTRA_ARGS=

# --- UI --------------------------------------------------------------------------------
# rosbridge binds to the tablet-facing address only, never 0.0.0.0.
# TODO(Karthikeyan): set the robot address on the tablet network.
OPENAMR_ROSBRIDGE_ADDRESS=127.0.0.1
OPENAMR_ROSBRIDGE_PORT=9090
