<?xml version="1.0" encoding="UTF-8" ?>
<!-- /etc/openamr/cyclonedds.xml: Cyclone DDS settings for the robot host.
     Pins DDS to the wired robot interface and raises the receive buffer
     (ROS 2 DDS tuning guide). TODO(Karthikeyan): set the interface name on the unit. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="lo" multicast="false"/>
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>
    <Internal>
      <SocketReceiveBufferSize min="10MB"/>
    </Internal>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
    </Discovery>
  </Domain>
</CycloneDDS>
